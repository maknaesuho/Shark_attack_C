    "# checking all entries for a column Fatal\n",
    "shark_attack['Fatal Y/N'].value_counts()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 173,
   "id": "708a18b4-a26d-4f31-a551-e8a9a7bcdc6f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# cleaning values for Fatal Y/N to have only: Y, N, UNKNOWN\n",
    "shark_attack['Fatal Y/N'] = shark_attack['Fatal Y/N'].replace([\"F\", \"M\", \"Y x 2\"], \"Y\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 174,
   "id": "b9b9f76b-6f75-4b17-861d-b10af1309a76",
   "metadata": {},
   "outputs": [],
   "source": [
    "shark_attack['Fatal Y/N'] = shark_attack['Fatal Y/N'].replace([\"n\", \"Nq\"], \"N\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 175,
   "id": "c542a998-ae02-4f51-8a1f-f6d3cf418c49",
