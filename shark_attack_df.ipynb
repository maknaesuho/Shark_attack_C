   ],
   "source": [
    "# cleaning values for Time, first checking how many unique values we have\n",
    "shark_attack['Time'].nunique()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 176,
   "id": "17f585ba-17dd-480d-905e-211f6552d38e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extract and replace digits using RegEx and converts to a string. \\D+ for all strings that do not contain digits or characters\n",
    "\n",
    "cleaned = shark_attack['Time'].astype(str).str.replace(r'\\D+', '', regex=True)"
   ]
  },
