   "execution_count": 51,
   "id": "9b6b56af",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Select only the columns I want to clean\n",
    "columns_to_clean = [\"Country\", \"State\", \"Location\", \"Activity\"]\n",
    "\n",
    "shark_clean = shark_attack[columns_to_clean].copy()"
   ]
  },
